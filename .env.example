# OAuth Compass Environment Configuration
# Copy this file to .env.local for local overrides.
# DO NOT commit .env.local with real secrets.

# Application Server Port
PORT=3000

# Server-only LLM Configuration (Configurable: gemini | openai | anthropic)
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3.8-flash

# Optional: Tavily Search API Key for live web research
# If not provided, OAuth Compass falls back to safe official domain inspection & heuristic audit
TAVILY_API_KEY=your_tavily_api_key_here

# Persistent Storage Directory (defaults to ./data/guides.json)
DATA_DIR=./data
