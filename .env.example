# OAuth Compass Environment Configuration
# Copy this file to .env.local for local overrides.

# Application Server Port
PORT=3000

# Optional: LLM API key for live unfamiliar app generation
# If not provided, OAuth Compass uses its built-in heuristic knowledge base
# and safe documentation analyzer with explicit uncertainty labeling.
# OPENAI_API_KEY=your_openai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Persistent Storage Directory (defaults to ./data/guides.json)
# DATA_DIR=./data
